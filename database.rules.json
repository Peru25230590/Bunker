{
  "rules": {
    ".read": false,
    ".write": false,
    "events": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        "$eventId": {
          ".write": false,
          ".validate": "newData.hasChildren(['id', 'userId', 'title', 'startsAt', 'status', 'timeZone', 'createdAt', 'updatedAt', 'scheduleRevision'])",
          "id": { ".validate": "newData.val() === $eventId" },
          "userId": { ".validate": "newData.val() === $uid" },
          "title": { ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 160" },
          "description": { ".validate": "!newData.exists() || (newData.isString() && newData.val().length <= 2000)" },
          "startsAt": { ".validate": "newData.isNumber() && newData.val() > 0" },
          "status": { ".validate": "newData.val() === 'scheduled' || newData.val() === 'completed' || newData.val() === 'cancelled'" },
          "timeZone": { ".validate": "newData.isString() && newData.val().length <= 80" },
          "createdAt": { ".validate": "newData.isNumber()" },
          "updatedAt": { ".validate": "newData.isNumber()" },
          "scheduleRevision": { ".validate": "newData.isString() && newData.val().length <= 100" },
          "$other": { ".validate": false }
        }
      }
    },
    "preferences": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth != null && auth.uid === $uid",
        "remindersEnabled": { ".validate": "newData.isBoolean()" },
        "reminder1Day": { ".validate": "newData.isBoolean()" },
        "reminder2Days": { ".validate": "newData.isBoolean()" },
        "pushEnabled": { ".validate": "newData.isBoolean()" },
        "catSoundsEnabled": { ".validate": "newData.isBoolean()" },
        "theme": { ".validate": "newData.val() === 'light' || newData.val() === 'dark'" },
        "timeZone": { ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 80" },
        "$other": { ".validate": false }
      }
    },
    "pushTokens": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth != null && auth.uid === $uid",
        "$tokenId": {
          ".validate": "newData.hasChildren(['token', 'createdAt'])",
          "token": { ".validate": "newData.isString() && newData.val().length >= 20 && newData.val().length <= 4096" },
          "createdAt": { ".validate": "newData.isNumber()" },
          "$other": { ".validate": false }
        }
      }
    },
    "notifications": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": false
      }
    },
    "reminders": { ".read": false, ".write": false },
    "reminderQueue": { ".read": false, ".write": false, ".indexOn": ["scheduledAt"] },
    "pushDeliveries": { ".read": false, ".write": false },
    "eventScheduleMeta": { ".read": false, ".write": false },
    "users": {
      "$uid": {
        "profile": {
          ".read": "auth != null && auth.uid === $uid",
          ".write": "auth != null && auth.uid === $uid",
          ".validate": "newData.hasChildren(['uid', 'email', 'displayName', 'createdAt', 'updatedAt']) && newData.child('uid').val() === $uid && newData.child('email').isString() && newData.child('email').val().length <= 320 && newData.child('displayName').isString() && newData.child('displayName').val().length <= 50 && newData.child('createdAt').isString() && newData.child('updatedAt').isString()",
          "$other": { ".validate": "false" }
        },
        "notes": {
          ".read": "auth != null && auth.uid === $uid",
          ".write": "auth != null && auth.uid === $uid",
          "$noteId": {
            ".validate": "newData.hasChildren(['id', 'title', 'content', 'createdAt', 'updatedAt']) && newData.child('id').val() === $noteId && newData.child('title').isString() && newData.child('title').val().length > 0 && newData.child('title').val().length <= 120 && newData.child('content').isString() && newData.child('content').val().length <= 10000 && newData.child('createdAt').isString() && newData.child('updatedAt').isString() && (!newData.child('tags').exists() || newData.child('tags').numChildren() <= 20)",
            "$other": { ".validate": "false" }
          }
        },
        "$other": { ".read": false, ".write": false, ".validate": "false" }
      }
    }
  }
}
